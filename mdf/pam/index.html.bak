/* ═══════════════════════════════════════════════════════════
   MDF INTERNAL PORTAL — CORE APP
   Router · shared helpers · shell · role switching · dashboard
   ═══════════════════════════════════════════════════════════ */

const APP = {
  role:'pam',            // pam | marketing | admin
  screen:'dashboard',
  queueView:'table',     // table | cards  (Option A / Option B)
  queueFilter:'action',
  selectedId:null,       // for right panel
};

/* ── DOM helpers ─────────────────────────────────── */
const $  = (s,r=document)=>r.querySelector(s);
const $$ = (s,r=document)=>[...r.querySelectorAll(s)];
const el = (html)=>{const t=document.createElement('template');t.innerHTML=html.trim();return t.content.firstElementChild;};

/* ── formatting ──────────────────────────────────── */
const money = (n)=> n==null ? '—' : '$'+Number(n).toLocaleString('en-CA');
const money0 = (n)=> n==null ? '—' : '$'+Number(n).toLocaleString('en-CA',{maximumFractionDigits:0});
function fmtDate(d){ if(!d) return '—'; const dt=new Date(d); if(isNaN(dt)) return d; return dt.toLocaleDateString('en-CA',{year:'numeric',month:'short',day:'numeric'}); }
function fmtDateShort(d){ if(!d) return '—'; const dt=new Date(d); if(isNaN(dt)) return d; return dt.toLocaleDateString('en-CA',{month:'short',day:'numeric'}); }
function fmtDateTime(s){ if(!s) return '—'; const dt=new Date(s.replace(' ','T')); if(isNaN(dt)) return s; return dt.toLocaleDateString('en-CA',{month:'short',day:'numeric'})+' · '+dt.toLocaleTimeString('en-CA',{hour:'numeric',minute:'2-digit'}); }
const cap = (s)=> s? s.charAt(0).toUpperCase()+s.slice(1) : '';
const daysBetween = (a,b)=> Math.round((new Date(a)-new Date(b))/86400000);

/* ── label maps ──────────────────────────────────── */
const STATUS = {
  draft:{label:'Draft',badge:'draft'},
  submitted:{label:'Submitted',badge:'submitted'},
  under_review:{label:'Under Review',badge:'review'},
  pending_info:{label:'Pending Info',badge:'info'},
  pam_approved:{label:'PAM Approved',badge:'pam'},
  approved:{label:'Approved',badge:'approved'},
  rejected:{label:'Rejected',badge:'rejected'},
  executed:{label:'Executed',badge:'executed'},
  payout_pending:{label:'Payout Pending',badge:'payout'},
  paid:{label:'Paid',badge:'paid'},
};
const statusLabel = (s)=> (STATUS[s]||{label:s}).label;
const statusBadge = (s)=> `<span class="badge badge-${(STATUS[s]||{}).badge||'draft'}">${statusLabel(s)}</span>`;

const CATEGORY = { pipeline_building:'Pipeline Building', ecosystem_building:'Ecosystem Building', capability_building:'Capability Building' };
const ACTIVITY = { events:'Events', custom_gtm:'Custom GTM Strategy' };
const FORMAT = { in_person:'In-person', online:'Online', hybrid:'Hybrid' };
const EVTYPE = { self_hosted:'Self-hosted', third_party:'Third-party event' };

const TIER_COLORS = { authorized:'#71717A', advanced:'#1A4F8A', premium:'#5B21B6' };
const PARTNER_COLORS = ['#1A4F8A','#0B7B5E','#5B21B6','#9A6500','#B52A2A'];
function partnerColor(key){ const keys=Object.keys(PARTNERS); return PARTNER_COLORS[keys.indexOf(key)%PARTNER_COLORS.length]; }
const partnerOf = (req)=> PARTNERS[req.partner];
const initials = (name)=> name.split(/\s+/).slice(0,2).map(w=>w[0]).join('').toUpperCase();

/* ── SLA ─────────────────────────────────────────── */
const OPEN_STATES = ['submitted','under_review','pending_info'];
function slaInfo(req){
  if(!req.slaDue || !OPEN_STATES.includes(req.status)) return null;
  const d = daysBetween(req.slaDue, TODAY);   // days until due (negative = breached)
  if(d < 0)  return {cls:'sla-breach', label:`SLA breached · ${Math.abs(d)}d over`, sev:3};
  if(d === 0) return {cls:'sla-warn', label:'SLA due today', sev:2};
  if(d <= 1)  return {cls:'sla-warn', label:'Due tomorrow', sev:2};
  return {cls:'sla-ok', label:`${d}d to SLA`, sev:1};
}
function slaPill(req){ const s=slaInfo(req); return s? `<span class="sla ${s.cls}">${s.label}</span>` : ''; }

/* ── role-aware request scoping ──────────────────── */
function visibleRequests(){
  let rs = REQUESTS.filter(r=>r.status!=='draft' || APP.role==='admin');
  if(APP.role==='pam'){
    const terr = USERS.pam.territories;
    rs = rs.filter(r=> terr.includes(partnerOf(r).territory));
  }
  return rs;
}
// Items needing THIS role's action
function actionItems(){
  const rs = visibleRequests();
  if(APP.role==='marketing') return rs.filter(r=> r.status==='pam_approved');
  if(APP.role==='admin')     return rs.filter(r=> OPEN_STATES.includes(r.status) || r.status==='pam_approved');
  return rs.filter(r=> OPEN_STATES.includes(r.status)); // pam
}
function payoutItems(){ return visibleRequests().filter(r=> ['executed','payout_pending','paid'].includes(r.status)); }
function approvedItems(){ return visibleRequests().filter(r=> ['approved','executed','payout_pending','paid'].includes(r.status)); }

/* ── NAV definition ──────────────────────────────── */
const NAV = [
  {group:'Workspace', items:[
    {id:'dashboard', label:'Dashboard', icon:'grid', tip:'Overview of your queue, SLA status, budget rollup, and recent activity'},
    {id:'queue', tip:'All submitted requests awaiting your review, sorted by SLA urgency',     label:'Review Queue', icon:'inbox', count:()=>actionItems().length, alert:()=>actionItems().some(r=>{const s=slaInfo(r);return s&&s.sev===3;})},
    {id:'approved', tip:'Requests you have approved — tracking execution through to payout',  label:'Approved', icon:'check', count:()=>approvedItems().length},
    {id:'payouts', tip:'Post-event submissions ready to process and disburse to partners',   label:'Payouts', icon:'cash', count:()=>visibleRequests().filter(r=>r.status==='payout_pending').length},
  ]},
  {group:'Program', items:[
    {id:'partners', tip:'Budget health and activity summary across all your assigned partners',  label:'Partners', icon:'users'},
    {id:'reports', tip:'Program analytics — approval rates, committed funds, PAM workload',   label:'Reports', icon:'chart'},
  ]},
  {group:'Administration', adminOnly:true, items:[
    {id:'config', tip:'Global policy settings — budget caps, file limits, SLA windows',    label:'Configuration', icon:'cog'},
  ]},
];

const ICONS = {
  grid:'<path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z"/>',
  inbox:'<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>',
  check:'<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/>',
  cash:'<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/>',
  users:'<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  chart:'<path d="M3 3v18h18"/><path d="m7 14 4-4 3 3 5-6"/>',
  clock:'<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  warn:'<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
  copy:'<rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
  cog:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
};
const icon = (name, cls='nav-ic')=> `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${ICONS[name]||''}</svg>`;

const SCREEN_TITLES = {
  dashboard:['Dashboard', ()=>`${USERS[APP.role].roleLabel} · ${USERS[APP.role].territories.join(', ')}`],
  queue:['Review Queue', ()=> APP.role==='marketing' ? 'Requests awaiting final Marketing approval' : 'Requests awaiting your review & action'],
  approved:['Approved Requests', ()=>'Committed funds — through to payout'],
  payouts:['Payouts', ()=>'Post-event submissions, payout processing & Partner Store sync'],
  partners:['Partners', ()=>'Budget utilisation by partner — FY2026'],
  reports:['Reports', ()=>'Program performance & PAM workload'],
  config:['Configuration', ()=>'Global MDF policy & limits'],
  sla:['SLA Risks', ()=>'Requests approaching or past the 5-day review window'],
  exceptions:['Budget Exceptions', ()=>'Requests where co-fund ask exceeds partner available balance'],
  duplicates:['Duplicates', ()=>'Requests flagged as possible duplicate activity submissions'],
};

/* ── render shell ────────────────────────────────── */
function renderNav(){
  const u = USERS[APP.role];
  const groups = NAV.filter(g=> !g.adminOnly || APP.role==='admin').map(g=>`
    <div class="nav-group-lbl">${g.group}</div>
    ${g.items.map(it=>{
      const c = it.count? it.count() : null;
      const alert = it.alert? it.alert() : false;
      return `<button class="nav-item ${APP.screen===it.id?'active':''}" onclick="go('${it.id}')">
        ${icon(it.icon)}<span style="flex:1">${it.label}</span>
        ${it.tip?`<span class="tip-wrap" style="margin-left:auto"><span class="tip-ic" title="${it.tip}">i</span><span class="tip-pop">${it.tip}</span></span>`:''}
        ${c!=null && c>0 ? `<span class="nav-count ${alert?'alert':''}">${c}</span>`:''}
      </button>`;
    }).join('')}
  `).join('');
  $('#nav-items').innerHTML = groups;
  $('#nav-user').innerHTML = `
    <div class="nav-avatar" style="background:${APP.role==='admin'?'#5B21B6':APP.role==='marketing'?'#9A6500':'#0B7B5E'}">${u.initials}</div>
    <div style="min-width:0">
      <div class="nav-user-name">${u.name}</div>
      <div class="nav-user-role">${u.roleLabel}</div>
    </div>`;
  $('#nav-scope').innerHTML = `${icon('users','nav-ic')}<span>Scope: <strong>${u.territories.join(', ')}</strong></span>`;
}

function renderTopbar(){
  const [title, sub] = SCREEN_TITLES[APP.screen]||['',()=>''];
  $('#tb-title').textContent = title;
  $('#tb-sub').textContent = typeof sub==='function'? sub() : sub;
  $$('.role-btn').forEach(b=> b.classList.toggle('active', b.dataset.role===APP.role));
}

/* ── routing ─────────────────────────────────────── */
function go(screen){
  APP.screen = screen;
  APP.selectedId = null;
  closePanel();
  renderNav(); renderTopbar();
  $$('.screen').forEach(s=>s.classList.remove('active'));
  const target = $('#screen-'+screen);
  if(target) target.classList.add('active');
  const r = {
    dashboard:renderDashboard, queue:renderQueue, approved:renderApproved,
    payouts:renderPayouts, partners:renderPartners, reports:renderReports, config:renderConfig
  }[screen];
  if(typeof r==='function') r();
  const lc = $('.screen.active .list-col'); if(lc) lc.scrollTop = 0;
}

function setRole(role){
  APP.role = role;
  go(APP.screen==='config' && role!=='admin' ? 'dashboard' : APP.screen);
}

function setQueueView(v){ APP.queueView=v; renderQueue(); }

/* ── DASHBOARD ───────────────────────────────────── */
function renderDashboard(){
  const rs = visibleRequests();
  const actions = actionItems();
  const breached = actions.filter(r=>{const s=slaInfo(r);return s&&s.sev===3;});
  const dueSoon = actions.filter(r=>{const s=slaInfo(r);return s&&s.sev===2;});
  const payoutPend = rs.filter(r=>r.status==='payout_pending');

  // program budget rollup across visible partners
  const pkeys = (APP.role==='pam')
    ? Object.keys(PARTNERS).filter(k=>USERS[APP.role].territories.includes(PARTNERS[k].territory))
    : Object.keys(PARTNERS);
  const roll = pkeys.reduce((a,k)=>{const b=PARTNERS[k].budget;a.cap+=b.cap;a.committed+=b.committed;a.paid+=b.paid;a.available+=b.available;return a;},{cap:0,committed:0,paid:0,available:0});

  const actLabel = APP.role==='marketing' ? 'Awaiting final approval' : 'Awaiting your action';

  const html = `
  <div class="list-col"><div class="list-pad">
    <div class="kpi-row kpi-4">
      <div class="kpi accent-blue">
        <div class="kpi-lbl">${actLabel} <span class="tip-wrap tip-left"><span class="tip-ic">i</span><span class="tip-pop">Requests in Submitted, Under Review, or Pending Info status that need your action</span></span></div>
        <div class="kpi-val tabnum">${actions.length}</div>
        <div class="kpi-meta"><span class="kpi-tick" style="background:var(--blue)"></span>${dueSoon.length} due soon</div>
      </div>
      <div class="kpi accent-red">
        <div class="kpi-lbl">SLA Breached <span class="tip-wrap tip-left"><span class="tip-ic">i</span><span class="tip-pop">Requests that passed the 5-business-day review window without a PAM action</span></span></div>
        <div class="kpi-val tabnum" style="color:${breached.length?'var(--red)':'var(--text)'}">${breached.length}</div>
        <div class="kpi-meta">${breached.length? 'Action overdue':'All within SLA'}</div>
      </div>
      <div class="kpi accent-teal">
        <div class="kpi-lbl">Payouts Pending <span class="tip-wrap tip-left"><span class="tip-ic">i</span><span class="tip-pop">Partners who have submitted their post-event form and are waiting for payout processing</span></span></div>
        <div class="kpi-val tabnum">${payoutPend.length}</div>
        <div class="kpi-meta">${money0(payoutPend.reduce((a,r)=>a+(r.approvedAmount||0),0))} committed</div>
      </div>
      <div class="kpi accent-green">
        <div class="kpi-lbl">Available Budget <span class="tip-wrap tip-left"><span class="tip-ic">i</span><span class="tip-pop">Budget Cap minus Committed (approved, not yet paid) minus Paid — across all your visible partners</span></span></div>
        <div class="kpi-val tabnum">${money0(roll.available)}</div>
        <div class="kpi-meta">of ${money0(roll.cap)} cap</div>
      </div>
    </div>

    <div class="sec-hdr" style="margin-bottom:12px">
      <div><div class="sec-title" style="font-size:18px">${APP.role==='marketing'?'Awaiting your approval':'Needs your attention'}</div></div>
      <button class="btn btn-ghost btn-sm" onclick="go('queue')">Open queue →</button>
    </div>
    ${actions.length
      ? queueTableHTML(actions.sort(slaSort).slice(0,6))
      : emptyState('🎉','You\'re all caught up','Nothing in your queue needs action right now.')}

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start;margin-top:24px">
      <div>
        <div class="sec-label">Program Budget · FY2026</div>
        ${budgetBlockHTML('Across '+pkeys.length+' partners', roll)}
      </div>
      <div>
        <div class="sec-label">Recent activity</div>
        <div class="card"><div class="card-bd"><div class="timeline">
          ${recentActivity().map(a=>`
            <div class="tl-item ${a.cls==='future'?'tl-future':a.cls}"><div class="tl-dot"></div>
              <div class="tl-title" style="font-size:12.5px">${a.title}</div>
              <div class="tl-meta">${a.ref} · ${a.who||'System'} · ${fmtDateTime(a.when)}</div>
            </div>`).join('')}
        </div></div></div>
      </div>
    </div>
  </div></div>`;
  $('#screen-dashboard').innerHTML = html;
}

function slaSort(a,b){ const sa=slaInfo(a),sb=slaInfo(b); const va=sa?sa.sev:0, vb=sb?sb.sev:0; if(vb!==va) return vb-va; return new Date(a.submittedAt||0)-new Date(b.submittedAt||0); }

function recentActivity(){
  const evts=[];
  visibleRequests().forEach(r=> r.timeline.forEach(t=>{ if(t.when) evts.push({...t, ref:r.ref, who:t.who}); }));
  return evts.sort((a,b)=> new Date(b.when.replace(' ','T'))-new Date(a.when.replace(' ','T'))).slice(0,6);
}

/* ── shared budget block (KPI cards + compact util bar) ── */
function budgetBlockHTML(label, b){
  const used = b.committed + b.paid;
  const pctCommit = b.cap? (b.committed/b.cap*100):0;
  const pctPaid = b.cap? (b.paid/b.cap*100):0;
  const utilPct = b.cap? Math.round(used/b.cap*100):0;
  return `<div class="budget-block">
    <div class="bb-head"><div class="bb-title">${label}</div><div class="bb-fy">FY2026</div></div>
    <div class="bb-kpis">
      <div class="bb-kpi"><div class="bb-kpi-lbl"><span class="dotk cap"></span>Cap</div><div class="bb-kpi-val">${money0(b.cap)}</div></div>
      <div class="bb-kpi"><div class="bb-kpi-lbl"><span class="dotk committed"></span>Committed</div><div class="bb-kpi-val">${money0(b.committed)}</div></div>
      <div class="bb-kpi"><div class="bb-kpi-lbl"><span class="dotk paid"></span>Paid</div><div class="bb-kpi-val">${money0(b.paid)}</div></div>
      <div class="bb-kpi"><div class="bb-kpi-lbl"><span class="dotk available"></span>Available</div><div class="bb-kpi-val" style="color:${b.available<=0?'var(--red)':'var(--green)'}">${money0(b.available)}</div></div>
    </div>
    <div class="util">
      <span class="util-pct">${utilPct}% utilised</span>
      <div class="util-bar">
        <div class="util-seg committed" style="width:${pctCommit}%"></div>
        <div class="util-seg paid" style="width:${pctPaid}%"></div>
      </div>
      <div class="util-legend">
        <div class="util-leg"><span class="dotk committed"></span>Committed</div>
        <div class="util-leg"><span class="dotk paid"></span>Paid</div>
        <div class="util-leg"><span class="dotk available" style="background:var(--bg);border:1px solid var(--bd)"></span>Available</div>
      </div>
    </div>
  </div>`;
}

function emptyState(ic,t,s){ return `<div class="empty"><div class="empty-ic">${ic}</div><div class="empty-t">${t}</div><div class="empty-s">${s}</div></div>`; }

/* ── toast & modal ───────────────────────────────── */
let toastTimer=null;
function toast(msg, icon='✓'){
  const t=$('#toast'); $('#toast-msg').textContent=msg; $('#toast .tk').textContent=icon;
  t.classList.add('show'); clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),2800);
}
function openModal(html){ $('#modal-root').innerHTML=html; $('#modal').classList.add('open'); }
function closeModal(){ $('#modal').classList.remove('open'); setTimeout(()=>{ if(!$('#modal').classList.contains('open')) $('#modal-root').innerHTML=''; },200); }

/* ── right panel open/close ──────────────────────── */
function closePanel(){ const p=$('#panel'); if(p){ p.classList.remove('open'); } APP.selectedId=null; $$('.qt-row.sel, .qcard.sel').forEach(e=>e.classList.remove('sel')); }

/* ── boot ────────────────────────────────────────── */
function boot(){
  renderNav();
  $('#role-switch').innerHTML = ['pam','marketing','admin'].map(r=>`<button class="role-btn ${APP.role===r?'active':''}" data-role="${r}" onclick="setRole('${r}')">${USERS[r].role==='pam'?'PAM':cap(r)}</button>`).join('');
  go('dashboard');
}

/* ═══════════════════════════════════════════════════════════
   RISK & OPS SCREENS + ANALYTICS ROI
   ═══════════════════════════════════════════════════════════ */

/* ── SLA RISKS ───────────────────────────────────────────── */
function renderSLA(){
  const rs = visibleRequests().filter(r=> OPEN_STATES.includes(r.status) && r.slaDue);
  const breached = rs.filter(r=>{const s=slaInfo(r);return s&&s.sev===3;}).sort(slaSort);
  const warn     = rs.filter(r=>{const s=slaInfo(r);return s&&s.sev===2;}).sort(slaSort);
  const ok       = rs.filter(r=>{const s=slaInfo(r);return s&&s.sev===1;}).sort(slaSort);

  const section = (title, color, items) => !items.length ? '' : `
    <div style="margin-bottom:24px">
      <div class="sec-label" style="color:${color}">${title} (${items.length})</div>
      ${queueTableHTML(items)}
    </div>`;

  $('#screen-sla').innerHTML = `<div class="list-col"><div class="list-pad">
    <div class="kpi-row kpi-3">
      <div class="kpi accent-red"><div class="kpi-lbl">Breached</div><div class="kpi-val tabnum" style="color:${breached.length?'var(--red)':'var(--text)'}">${breached.length}</div><div class="kpi-meta">Past ${CONFIG.sla_review_days}-day window</div></div>
      <div class="kpi accent-amber"><div class="kpi-lbl">Due Today / Tomorrow</div><div class="kpi-val tabnum">${warn.length}</div><div class="kpi-meta">Act before breach</div></div>
      <div class="kpi accent-green"><div class="kpi-lbl">On Track</div><div class="kpi-val tabnum">${ok.length}</div><div class="kpi-meta">Within SLA window</div></div>
    </div>
    ${breached.length ? `<div class="banner banner-red" style="margin-bottom:18px"><div class="banner-icon">!</div><div><div class="banner-title">${breached.length} request${breached.length>1?'s':''} breached the ${CONFIG.sla_review_days}-day SLA</div><div class="banner-body">These require immediate action. Each day of delay erodes partner trust and increases the risk of escalation.</div></div></div>` : ''}
    ${section('Breached — act now', 'var(--red)', breached)}
    ${section('Due today or tomorrow', 'var(--amber)', warn)}
    ${section('On track', 'var(--hint)', ok)}
    ${!rs.length ? emptyState('✓','No open requests','Nothing in your queue is awaiting review.') : ''}
  </div></div>`;
}

/* ── BUDGET EXCEPTIONS ───────────────────────────────────── */
function renderExceptions(){
  const rs = visibleRequests().filter(r=>{
    if(!OPEN_STATES.includes(r.status)) return false;
    const p = partnerOf(r);
    return r.requestedCofund > p.budget.available || (r.flags||[]).includes('budget');
  });

  const cols=[
    {label:'Reference',w:'120px'},{label:'Activity / Partner',w:'minmax(0,1.6fr)'},
    {label:'Requested',w:'110px',r:true},{label:'Available',w:'110px',r:true},
    {label:'Gap',w:'110px',r:true},{label:'Status',w:'120px',r:true}
  ];
  const rows = rs.map(r=>{
    const p=partnerOf(r);
    const gap = r.requestedCofund - p.budget.available;
    return {id:r.id,cells:[
      `<div class="qt-ref">${r.ref}</div>`,
      `<div class="qt-name">${r.name}</div><div class="qt-actline"><span class="av av-sm" style="background:${partnerColor(r.partner)};width:18px;height:18px;font-size:8px">${initials(p.name)}</span> ${p.name} · <span class="tier ${p.tier}">${p.tier}</span></div>`,
      `<div class="qt-amt">${money0(r.requestedCofund)}</div>`,
      `<div class="qt-amt" style="color:${p.budget.available<=0?'var(--red)':'var(--amber)'}">${money0(p.budget.available)}</div>`,
      `<div class="qt-amt" style="color:var(--red);font-weight:700">+${money0(gap)}</div>`,
      statusBadge(r.status)
    ]};
  });

  $('#screen-exceptions').innerHTML = `<div class="list-col"><div class="list-pad">
    <div class="banner banner-amber" style="margin-bottom:18px"><div class="banner-icon">$</div><div><div class="banner-title">Over-balance requests can still be approved</div><div class="banner-body">These requests exceed the partner's available MDF balance. You can still approve at a reduced amount, or approve in full (over-committing the budget) if circumstances warrant — document the reason.</div></div></div>
    ${rs.length ? listTable(cols,rows) : emptyState('✓','No budget exceptions','All open requests are within partner available balances.')}
  </div></div>`;
}

/* ── DUPLICATES ──────────────────────────────────────────── */
function renderDuplicates(){
  const rs = visibleRequests().filter(r=>(r.flags||[]).includes('duplicate'));

  const cols=[
    {label:'Reference',w:'120px'},{label:'Activity',w:'minmax(0,1.4fr)'},
    {label:'Partner',w:'1fr'},{label:'Prior request',w:'minmax(0,1.4fr)'},
    {label:'Status',w:'130px',r:true}
  ];
  const rows = rs.map(r=>{
    const p=partnerOf(r);
    return {id:r.id,cells:[
      `<div class="qt-ref">${r.ref}</div><div class="qt-ref-date">${fmtDateShort(r.submittedAt)}</div>`,
      `<div class="qt-name">${r.name}</div><div class="qt-actline">${ACTIVITY[r.activity]}</div>`,
      `<div class="qt-partner">${p.name}</div><div class="qt-partner-sub"><span class="tier ${p.tier}">${p.tier}</span> ${p.territory}</div>`,
      `<div style="font-size:12px;color:var(--muted);line-height:1.4">${r.dupNote||'See prior submissions for this partner'}</div>`,
      `${statusBadge(r.status)} <span class="flag flag-dup" style="margin-top:4px">Duplicate</span>`
    ]};
  });

  $('#screen-duplicates').innerHTML = `<div class="list-col"><div class="list-pad">
    <div class="banner banner-blue" style="margin-bottom:18px"><div class="banner-icon">i</div><div><div class="banner-title">Duplicate detection window: ${CONFIG.duplicate_window_days} days</div><div class="banner-body">These requests were flagged because the same partner submitted a similar activity type within the last ${CONFIG.duplicate_window_days} days. Review both submissions before approving. You can override the duplicate flag with a documented reason.</div></div></div>
    ${rs.length ? listTable(cols,rows) : emptyState('✓','No duplicates detected','No requests match prior submissions within the duplicate detection window.')}
  </div></div>`;
}

document.addEventListener('DOMContentLoaded', boot);

/* ═══════════════════════════════════════════════════════════
   REVIEW QUEUE — Option A (dense table) / Option B (card console)
   + right-side quick panel.  Role-aware (PAM / Marketing / Admin).
   ═══════════════════════════════════════════════════════════ */

function queueFilters(){
  if(APP.role==='marketing'){
    return [ {id:'action',label:'Awaiting approval',f:r=>r.status==='pam_approved'} ];
  }
  return [
    {id:'action', label:'Needs action', f:r=>OPEN_STATES.includes(r.status)||(APP.role==='admin'&&r.status==='pam_approved')},
    {id:'breach', label:'SLA breached', f:r=>{const s=slaInfo(r);return s&&s.sev===3;}},
    {id:'submitted', label:'New', f:r=>r.status==='submitted'},
    {id:'under_review', label:'Under review', f:r=>r.status==='under_review'},
    {id:'pending_info', label:'Pending info', f:r=>r.status==='pending_info'},
  ];
}

function queueData(){
  const filt = queueFilters().find(f=>f.id===APP.queueFilter) || queueFilters()[0];
  return visibleRequests().filter(filt.f).sort(slaSort);
}

function renderQueue(){
  if(APP.role==='marketing' && APP.queueFilter!=='action') APP.queueFilter='action';
  const filters = queueFilters();
  const data = queueData();
  const counts = {}; filters.forEach(f=> counts[f.id]=visibleRequests().filter(f.f).length);

  const toolbar = `
    <div class="toolbar">
      ${filters.map(f=>`<button class="fchip ${APP.queueFilter===f.id?'active':''}" onclick="setQueueFilter('${f.id}')">${f.label} <span class="fc-n">${counts[f.id]}</span></button>`).join('')}
      <div class="spacer"></div>
      <div class="view-toggle">
        <button class="vt-btn ${APP.queueView==='table'?'active':''}" onclick="setQueueView('table')">${vIcon('rows')} Table</button>
        <button class="vt-btn ${APP.queueView==='cards'?'active':''}" onclick="setQueueView('cards')">${vIcon('cards')} Cards</button>
      </div>
    </div>`;

  let body;
  if(!data.length){
    body = emptyState('✓','Nothing here','No requests match this filter.');
  } else if(APP.queueView==='table'){
    body = queueTableHTML(data);
  } else {
    body = `<div class="qcards">${data.map(r=>queueCardHTML(r)).join('')}</div>`;
  }

  $('#screen-queue').innerHTML = `<div class="content">
    <div class="list-col"><div class="list-pad">${toolbar}${body}</div></div>
    <div class="panel" id="panel"></div>
  </div>`;
  if(APP.selectedId) openPanel(APP.selectedId, true);
}

function setQueueFilter(id){ APP.queueFilter=id; renderQueue(); }

/* shared table builder (used by queue + dashboard) */
function queueTableHTML(data){
  return `<div class="qtable">
    <div class="qt-head"><div>Reference</div><div>Activity</div><div>Partner</div><div>SLA</div><div class="qt-cell-r">Requested</div><div>Flags</div><div class="qt-cell-r">Status</div></div>
    ${data.map(r=>queueRowHTML(r)).join('')}
  </div>`;
}
const vIcon = (k)=> k==='rows'
  ? '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>'
  : '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>';

/* ── flags rendering ─────────────────────────────── */
function flagsHTML(r){
  return (r.flags||[]).map(f=>{
    if(f==='duplicate') return '<span class="flag flag-dup" title="Possible duplicate">Duplicate</span>';
    if(f==='budget')    return '<span class="flag flag-budget" title="Over available balance">Over budget</span>';
    if(f==='docs')      return '<span class="flag flag-docs" title="Missing documentation">Missing docs</span>';
    return '';
  }).join(' ');
}

/* ── activity sub-line ───────────────────────────── */
function activityLine(r){
  if(r.activity==='custom_gtm') return `Custom GTM${r.gtm&&r.gtm.industries?.length?` · ${r.gtm.industries.join(', ')}`:''}`;
  const bits=[FORMAT[r.eventFormat]||'', EVTYPE[r.eventType]||''].filter(Boolean);
  if(r.participation) bits.push(cap(r.participation));
  return bits.join(' · ');
}

/* ── TABLE ROW (also used on dashboard) ──────────── */
function queueRowHTML(r){
  const p = partnerOf(r);
  const sla = slaInfo(r);
  const urgent = sla && sla.sev===3;
  return `<div class="qt-row ${urgent?'urgent':''} ${APP.selectedId===r.id?'sel':''}" onclick="openPanel(${r.id})">
    <div><div class="qt-ref">${r.ref}</div><div class="qt-ref-date">${r.submittedAt?fmtDateShort(r.submittedAt):'—'}</div></div>
    <div style="min-width:0"><div class="qt-name">${r.name}</div><div class="qt-actline">${ACTIVITY[r.activity]} · ${activityLine(r)}</div></div>
    <div style="min-width:0"><div class="qt-partner">${p.name}</div><div class="qt-partner-sub"><span class="tier ${p.tier}">${p.tier}</span> ${p.territory}</div></div>
    <div>${sla?`<span class="sla ${sla.cls}">${sla.sev===3?'Breached':sla.sev===2?'Due now':daysBetween(r.slaDue,TODAY)+'d'}</span>`:'<span class="hint" style="font-size:11px">—</span>'}</div>
    <div class="qt-cell-r"><div class="qt-amt">${money0(r.requestedCofund)}</div><div class="qt-amt-sub">${r.cofundPct}% of ${money0(r.requested)}</div></div>
    <div>${flagsHTML(r)||'<span class="hint">—</span>'}</div>
    <div class="qt-cell-r">${statusBadge(r.status)}</div>
  </div>`;
}

/* ── CARD (Option B) ─────────────────────────────── */
function queueCardHTML(r){
  const p = partnerOf(r);
  const sla = slaInfo(r);
  const urgent = sla && sla.sev===3;
  return `<div class="qcard ${urgent?'urgent':''} ${APP.selectedId===r.id?'sel':''}" onclick="openPanel(${r.id})">
    <div class="qc-top">
      <div class="qc-row1"><div class="qc-ref">${r.ref}</div>${statusBadge(r.status)}</div>
      <div class="qc-name">${r.name}</div>
      <div class="qc-meta">${slaPill(r)}${flagsHTML(r)}</div>
    </div>
    <div class="qc-body">
      <div class="qc-line"><span class="l">${ACTIVITY[r.activity]}</span><span class="v" style="font-weight:500;color:var(--muted)">${activityLine(r)||'—'}</span></div>
      ${r.eventDate?`<div class="qc-line"><span class="l">Event date</span><span class="v">${fmtDate(r.eventDate)}</span></div>`:''}
      <div class="qc-line"><span class="l">Requested co-fund</span><span class="v">${money0(r.requestedCofund)} <span class="hint" style="font-weight:500">(${r.cofundPct}%)</span></span></div>
    </div>
    <div class="qc-foot">
      <div class="qc-partner"><span class="av av-sm" style="background:${partnerColor(r.partner)}">${initials(p.name)}</span><strong>${p.name}</strong></div>
      <span class="tier ${p.tier}">${p.tier}</span>
    </div>
  </div>`;
}

/* ── RIGHT QUICK PANEL ───────────────────────────── */
function openPanel(id, keepScroll){
  APP.selectedId = id;
  const r = REQUESTS.find(x=>x.id===id); if(!r) return;
  const p = partnerOf(r);
  $$('.qt-row, .qcard').forEach(e=>e.classList.remove('sel'));
  const panel = $('#panel'); if(!panel) return;

  const banner = panelBanner(r);
  const actions = panelActions(r);

  panel.innerHTML = `
    <div class="panel-hd">
      <div style="min-width:0"><div class="panel-ref">${r.ref}</div><div class="panel-name">${r.name}</div>
        <div style="margin-top:8px;display:flex;gap:7px;align-items:center;flex-wrap:wrap">${statusBadge(r.status)}${slaPill(r)}</div>
      </div>
      <button class="panel-close" onclick="closePanel()">×</button>
    </div>
    <div class="panel-body">
      ${banner}
      <div>
        <div class="panel-sec-lbl">Partner</div>
        <div class="row" style="gap:10px"><span class="av" style="background:${partnerColor(r.partner)}">${initials(p.name)}</span>
          <div style="min-width:0"><div style="font-weight:600;font-size:13px">${p.name}</div><div class="muted" style="font-size:12px"><span class="tier ${p.tier}">${p.tier}</span> · ${p.territory} · PAM ${p.pam}</div></div>
        </div>
      </div>
      <div>
        <div class="panel-sec-lbl">Request</div>
        <div class="kv">
          <div class="k">Category</div><div class="v">${CATEGORY[r.category]}</div>
          <div class="k">Activity</div><div class="v">${ACTIVITY[r.activity]}</div>
          ${r.activity==='events'?`<div class="k">Format</div><div class="v">${FORMAT[r.eventFormat]||'—'} · ${EVTYPE[r.eventType]||'—'}</div>`:''}
          ${r.eventDate?`<div class="k">Event date</div><div class="v">${fmtDate(r.eventDate)}</div>`:''}
          ${r.footfall?`<div class="k">Expected footfall</div><div class="v mono">${r.footfall.toLocaleString()}</div>`:''}
          <div class="k">Marketing POC</div><div class="v">${r.poc}</div>
        </div>
      </div>
      <div>
        <div class="panel-sec-lbl">Budget request</div>
        <div class="msum" style="margin:0">
          <div class="msum-row"><span class="l">Total activity budget</span><span class="v">${money0(r.requested)}</span></div>
          <div class="msum-row"><span class="l">Co-fund requested (${r.cofundPct}%)</span><span class="v">${money0(r.requestedCofund)}</span></div>
          ${r.approvedAmount!=null?`<div class="msum-row total"><span class="l">${r.status==='pam_approved'?'PAM approved':'Approved'}</span><span class="v">${money0(r.approvedAmount)}</span></div>`:''}
        </div>
        ${overBalanceNote(r)}
      </div>
      ${r.attachments&&r.attachments.length?`<div><div class="panel-sec-lbl">Attachments (${r.attachments.length})</div>${r.attachments.map(a=>`<div class="row" style="gap:9px;padding:5px 0;font-size:12.5px"><span class="att-ic att-${a.type}" style="width:26px;height:26px;font-size:8px">${a.type.toUpperCase()}</span><span style="font-weight:500">${a.name}</span><span class="hint" style="margin-left:auto">${a.size}</span></div>`).join('')}</div>`:(r.flags||[]).includes('docs')?`<div class="banner banner-amber" style="margin:0"><div class="banner-icon">!</div><div><div class="banner-title">No documents attached</div><div class="banner-body">This request has no supporting documents.</div></div></div>`:''}
      <div class="link-detail" onclick="openDetail(${r.id})">Open full detail →</div>
    </div>
    ${actions?`<div class="panel-actions">${actions}</div>`:''}
  `;
  panel.classList.add('open');
  // mark selected row
  setTimeout(()=>{ $$('.qt-row, .qcard').forEach(e=>{ if(e.getAttribute('onclick')===`openPanel(${id})`) e.classList.add('sel'); }); },0);
}

function panelBanner(r){
  if(r.status==='rejected' && r.rejectionReason)
    return `<div class="banner banner-red" style="margin:0"><div class="banner-icon">✕</div><div><div class="banner-title">Rejected</div><div class="banner-body">${r.rejectionReason}</div></div></div>`;
  if(r.status==='pending_info' && r.infoRequest)
    return `<div class="banner banner-amber" style="margin:0"><div class="banner-icon">?</div><div><div class="banner-title">Awaiting partner response</div><div class="banner-body">${r.infoRequest}</div></div></div>`;
  if((r.flags||[]).includes('duplicate') && r.dupNote)
    return `<div class="banner banner-amber" style="margin:0"><div class="banner-icon">!</div><div><div class="banner-title">Possible duplicate</div><div class="banner-body">${r.dupNote}</div></div></div>`;
  return '';
}

function overBalanceNote(r){
  const p = partnerOf(r);
  if((r.flags||[]).includes('budget') || (OPEN_STATES.includes(r.status) && r.requestedCofund > p.budget.available)){
    return `<div class="banner banner-red" style="margin:10px 0 0"><div class="banner-icon">$</div><div><div class="banner-title">Exceeds available balance</div><div class="banner-body">${p.name} has ${money0(p.budget.available)} available. This request asks for ${money0(r.requestedCofund)}.</div></div></div>`;
  }
  return '';
}

/* ── panel action buttons (role-aware) ───────────── */
function panelActions(r){
  const canPAM = (APP.role==='pam'||APP.role==='admin');
  const canMkt = (APP.role==='marketing'||APP.role==='admin');
  if(OPEN_STATES.includes(r.status) && canPAM){
    return `<button class="btn btn-approve btn-block" onclick="openApprove(${r.id},'pam')">Approve</button>
      <div style="display:flex;gap:8px"><button class="btn btn-info" style="flex:1" onclick="openRequestInfo(${r.id})">Request Info</button>
      <button class="btn btn-reject" style="flex:1" onclick="openReject(${r.id})">Reject</button></div>`;
  }
  if(r.status==='pam_approved' && canMkt){
    return `<button class="btn btn-approve btn-block" onclick="openApprove(${r.id},'final')">Final Approve · ${money0(r.approvedAmount)}</button>
      <button class="btn btn-reject btn-block" onclick="openReject(${r.id})">Reject</button>`;
  }
  if(r.status==='payout_pending' && canPAM){
    return `<button class="btn btn-teal btn-block" onclick="openDetail(${r.id})">Process payout →</button>`;
  }
  if(r.status==='executed' && canPAM){
    return `<button class="btn btn-ghost btn-block" onclick="toast('Reminder sent to partner','✉')">Send post-event reminder</button>`;
  }
  return '';
}

/* ═══════════════════════════════════════════════════════════
   REQUEST DETAIL (full-screen) + APPROVAL / REJECT / INFO /
   PAYOUT action modals + state mutations.
   ═══════════════════════════════════════════════════════════ */

function nowStamp(){
  const t = new Date();
  return '2026-06-08 '+t.toLocaleTimeString('en-CA',{hour:'2-digit',minute:'2-digit',hour12:false});
}
function recomputeAvailable(b){ b.available = b.cap - b.committed - b.paid; }
const ATT_TYPE = (t)=> ({pdf:'att-pdf',img:'att-img',xls:'att-xls',doc:'att-doc'}[t]||'att-doc');

/* ── OPEN DETAIL ─────────────────────────────────── */
function openDetail(id){
  APP.selectedId = id;
  $$('.screen').forEach(s=>s.classList.remove('active'));
  $('#screen-detail').classList.add('active');
  renderDetail(id);
  $('.list-col')?.scrollTo?.(0,0);
  window.scrollTo(0,0);
}
function backFromDetail(){
  $('#screen-detail').classList.remove('active');
  go(APP.screen);
}

function renderDetail(id){
  const r = REQUESTS.find(x=>x.id===id); if(!r) return;
  const p = partnerOf(r);
  const b = p.budget;

  const banners = [];
  if(r.status==='rejected' && r.rejectionReason)
    banners.push(`<div class="banner banner-red"><div class="banner-icon">✕</div><div><div class="banner-title">Request rejected${r.actionedAt?` · ${fmtDate(r.actionedAt)}`:''}</div><div class="banner-body">${r.rejectionReason}</div></div></div>`);
  if(r.status==='pending_info' && r.infoRequest)
    banners.push(`<div class="banner banner-amber"><div class="banner-icon">?</div><div><div class="banner-title">Information requested from partner</div><div class="banner-body">${r.infoRequest}</div></div></div>`);
  if(['submitted','under_review'].includes(r.status) && (r.flags||[]).includes('duplicate') && r.dupNote)
    banners.push(`<div class="banner banner-amber"><div class="banner-icon">!</div><div><div class="banner-title">Possible duplicate activity</div><div class="banner-body">${r.dupNote} · Duplicate window: ${CONFIG.duplicate_window_days} days.</div></div></div>`);
  if(['submitted','under_review'].includes(r.status) && (r.requestedCofund > b.available))
    banners.push(`<div class="banner banner-red"><div class="banner-icon">$</div><div><div class="banner-title">Exceeds available MDF balance</div><div class="banner-body">${p.name} has <strong>${money0(b.available)}</strong> available for FY2026. This request asks for <strong>${money0(r.requestedCofund)}</strong>. Approving will over-commit the budget.</div></div></div>`);

  const left = `
    ${detailCard('Activity', `
      <div class="drow"><div class="dl">Category</div><div class="dv">${CATEGORY[r.category]}</div></div>
      <div class="drow"><div class="dl">Activity type</div><div class="dv">${ACTIVITY[r.activity]}</div></div>
      ${r.activity==='events'?`
        <div class="drow"><div class="dl">Event format</div><div class="dv">${FORMAT[r.eventFormat]||'—'}</div></div>
        <div class="drow"><div class="dl">Event type</div><div class="dv">${EVTYPE[r.eventType]||'—'}</div></div>
        ${r.participation?`<div class="drow"><div class="dl">Participation</div><div class="dv">${cap(r.participation)}</div></div>`:''}
        <div class="drow"><div class="dl">Event name</div><div class="dv">${r.name}</div></div>
        <div class="drow"><div class="dl">Event date</div><div class="dv">${fmtDate(r.eventDate)}</div></div>
        <div class="drow"><div class="dl">Expected footfall</div><div class="dv mono">${r.footfall?r.footfall.toLocaleString():'—'}</div></div>
      `:`
        <div class="drow"><div class="dl">Territory focus</div><div class="dv">${r.gtm?.territory||'—'}</div></div>
        <div class="drow"><div class="dl">Industry-specific solution</div><div class="dv">${r.gtm?.hasSolution?'Yes':'No'}</div></div>
        <div class="drow"><div class="dl">Industry focus</div><div class="dv">${r.gtm?.industries?.join(', ')||'—'}</div></div>
        <div class="drow"><div class="dl">ICP</div><div class="dv">${r.gtm?.icp||'—'}</div></div>
        <div class="drow"><div class="dl">GTM activities</div><div class="dv">${r.gtm?.activities?.join(', ')||'—'}</div></div>
        <div class="drow"><div class="dl">Reference customers</div><div class="dv">${r.gtm?.customers||'—'}</div></div>
        <div class="drow"><div class="dl">Prior GTM activity</div><div class="dv">${r.gtm?.prior||'—'}</div></div>
      `}
      ${r.desc?`<div class="drow"><div class="dl">Description</div><div class="dv" style="font-weight:400;line-height:1.55">${r.desc}</div></div>`:''}
      <div class="drow"><div class="dl">Marketing POC</div><div class="dv">${r.poc} · ${r.pocContact}</div></div>
    `)}

    ${detailCard('Budget request', `
      <div class="drow"><div class="dl">Total activity budget</div><div class="dv mono">${money(r.requested)}</div></div>
      <div class="drow"><div class="dl">Co-funding requested</div><div class="dv mono">${r.cofundPct}%</div></div>
      <div class="drow"><div class="dl">Co-fund amount requested</div><div class="dv mono">${money(r.requestedCofund)}</div></div>
      ${r.approvedAmount!=null?`<div class="drow"><div class="dl">${r.status==='pam_approved'?'PAM-approved amount':'Approved amount'}</div><div class="dv mono" style="color:var(--green)">${money(r.approvedAmount)}</div></div>`:''}
    `)}

    ${(r.status==='payout_pending'||r.status==='paid') && r.payout ? payoutCard(r) : ''}

    ${detailCard(`Attachments${r.attachments?.length?` (${r.attachments.length})`:''}`,
      r.attachments?.length
        ? r.attachments.map(a=>`<div class="att"><span class="att-ic ${ATT_TYPE(a.type)}">${a.type.toUpperCase()}</span><div style="min-width:0"><div class="att-name">${a.name}</div><div class="att-meta">${a.size}</div></div><button class="att-dl" onclick="toast('Generating signed download link…','⬇')">Download</button></div>`).join('')
        : `<div class="card-bd"><div class="muted" style="font-size:12.5px">No supporting documents attached.${(r.flags||[]).includes('docs')?' <strong style="color:var(--amber)">Documentation flagged as missing.</strong>':''}</div></div>`,
      true)}

    ${detailCard('Internal notes', `<div class="card-bd"><div class="notes" id="notes-list">${notesHTML(r)}</div>
        ${(APP.role!=='marketing'||true)?`<div style="margin-top:12px"><textarea class="fi fi-ta" id="note-input" placeholder="Add an internal note (not visible to the partner)…" style="min-height:64px"></textarea><div style="text-align:right;margin-top:8px"><button class="btn btn-ghost btn-sm" onclick="addNote(${r.id})">Add note</button></div></div>`:''}
      </div>`, true)}
  `;

  const right = `
    <div class="sec-label">Partner budget · FY2026</div>
    ${budgetBlockHTML(p.name, b)}
    <div class="card" style="margin-top:16px">
      <div class="card-hd"><div class="ch-title">Activity timeline</div></div>
      <div class="card-bd">${timelineHTML(r)}</div>
    </div>
  `;

  $('#screen-detail').innerHTML = `<div class="list-col"><div class="detail-wrap">
    <div class="breadcrumb"><a onclick="backFromDetail()">← ${SCREEN_TITLES[APP.screen][0]}</a><span class="breadcrumb-sep">/</span><span>${r.ref}</span></div>
    <div class="detail-hero">
      <div style="min-width:0">
        <div class="dh-ref">${r.ref}</div>
        <div class="dh-title">${r.name}</div>
        <div class="dh-meta">${statusBadge(r.status)}${slaPill(r)}
          <span class="row" style="gap:7px"><span class="av av-sm" style="background:${partnerColor(r.partner)}">${initials(p.name)}</span><span style="font-size:13px;font-weight:500">${p.name}</span></span>
          <span class="tier ${p.tier}">${p.tier}</span><span class="muted" style="font-size:12.5px">${p.territory}</span>
          ${r.submittedAt?`<span class="muted" style="font-size:12.5px">· Submitted ${fmtDate(r.submittedAt)}</span>`:''}
        </div>
      </div>
      <div class="dh-actions">${detailActions(r)}</div>
    </div>
    <div style="margin-top:20px">${banners.join('')}</div>
    <div class="detail-grid"><div style="min-width:0">${left}</div><div>${right}</div></div>
  </div></div>`;
}

function detailCard(title, inner){
  return `<div class="card"><div class="card-hd"><div class="ch-title">${title}</div></div>${inner}</div>`;
}

function notesHTML(r){
  if(!r.notes||!r.notes.length) return '<div class="muted" style="font-size:12.5px">No internal notes yet.</div>';
  return r.notes.map(n=>`<div class="note"><div class="note-hd"><span class="note-av">${n.initials}</span><span class="note-au">${n.author}</span><span class="note-tm">${fmtDate(n.when)}</span></div><div class="note-bd">${n.body}</div></div>`).join('');
}
function addNote(id){
  const r = REQUESTS.find(x=>x.id===id); const inp=$('#note-input'); if(!inp||!inp.value.trim()) return;
  const u = USERS[APP.role];
  r.notes.push({author:u.name, initials:u.initials, when:'2026-06-08', body:inp.value.trim()});
  $('#notes-list').innerHTML = notesHTML(r); inp.value='';
  toast('Note added');
}

/* ── activity timeline ───────────────────────────── */
function timelineHTML(r){
  return `<div class="timeline">${r.timeline.map(t=>`
    <div class="tl-item ${t.cls==='future'?'tl-future':t.cls}">
      <div class="tl-dot"></div>
      <div class="tl-title">${t.title}</div>
      <div class="tl-meta">${t.who?t.who+' · ':''}${t.when?fmtDateTime(t.when):'Pending'}</div>
      ${t.note?`<div class="tl-note">${t.note}</div>`:''}
    </div>`).join('')}</div>`;
}

/* ── payout card (post-event) ────────────────────── */
function payoutCard(r){
  const py = r.payout;
  const calc = Math.min(Math.round(py.actualSpend * r.cofundPct/100), r.approvedAmount, partnerOf(r).budget.available + (r.approvedAmount||0));
  const paid = r.status==='paid';
  return `<div class="card"><div class="card-hd"><div class="ch-title">Post-event submission</div><div class="ch-side">${py.submittedAt?'Submitted '+fmtDate(py.submittedAt):''}</div></div>
    <div class="drow"><div class="dl">Actual spend</div><div class="dv mono">${money(py.actualSpend)}</div></div>
    <div class="drow"><div class="dl">Actual footfall</div><div class="dv mono">${py.actualFootfall?.toLocaleString()||'—'}</div></div>
    <div class="drow"><div class="dl">Leads generated</div><div class="dv mono">${py.leads??'—'}</div></div>
    <div class="drow"><div class="dl">Outcomes</div><div class="dv" style="font-weight:400;line-height:1.55">${py.outcomes||'—'}</div></div>
    ${py.evidence?.length?`<div class="drow" style="align-items:start"><div class="dl">Evidence</div><div class="dv" style="font-weight:400"><div style="display:flex;flex-direction:column;gap:7px">${py.evidence.map(a=>`<div class="row" style="gap:8px"><span class="att-ic ${ATT_TYPE(a.type)}" style="width:24px;height:24px;font-size:8px">${a.type.toUpperCase()}</span><span style="font-weight:500;font-size:12.5px">${a.name}</span><span class="hint" style="font-size:11px">${a.size}</span></div>`).join('')}</div></div></div>`:''}
    ${paid?`
      <div class="drow"><div class="dl">Payout amount</div><div class="dv mono" style="color:var(--teal)">${money(py.payoutAmount)}</div></div>
      <div class="drow"><div class="dl">Partner Store sync</div><div class="dv">${syncPill(py.syncStatus)} <span class="hint" style="font-size:11px">${py.storeId||''}</span></div></div>
      <div class="drow"><div class="dl">Paid on</div><div class="dv">${fmtDate(py.paidAt)}</div></div>
    `:`
      <div style="padding:14px 17px;background:var(--teal-l);border-top:1px solid var(--teal-m)">
        <div style="font-size:12px;font-weight:700;color:#085041;letter-spacing:.03em;text-transform:uppercase;margin-bottom:9px">Payout calculation</div>
        <div class="msum" style="margin:0;background:var(--white);border-color:var(--teal-m)">
          <div class="msum-row"><span class="l">Actual spend × ${r.cofundPct}%</span><span class="v">${money0(Math.round(py.actualSpend*r.cofundPct/100))}</span></div>
          <div class="msum-row"><span class="l">Approved cap</span><span class="v">${money0(r.approvedAmount)}</span></div>
          <div class="msum-row"><span class="l">Available balance</span><span class="v">${money0(partnerOf(r).budget.available + (r.approvedAmount||0))}</span></div>
          <div class="msum-row total"><span class="l">Eligible payout (min)</span><span class="v">${money0(calc)}</span></div>
        </div>
        ${(APP.role==='pam'||APP.role==='admin')?`<button class="btn btn-teal btn-block mt12" onclick="openProcessPayout(${r.id})">Process payout →</button>`:'<div class="hint mt8" style="font-size:11.5px">Awaiting PAM payout processing.</div>'}
      </div>
    `}
  </div>`;
}
function syncPill(s){
  const m={ok:['sync-ok','✓ Synced'],pending:['sync-pending','Syncing…'],manual:['sync-manual','Manual disbursement'],fail:['sync-fail','✕ Failed']};
  const [cls,lbl]=m[s]||m.pending; return `<span class="sync ${cls}">${s==='pending'?'<span class="sync-spin"></span>':''}${lbl}</span>`;
}

/* ── detail hero actions (role-aware) ────────────── */
function detailActions(r){
  const canPAM=(APP.role==='pam'||APP.role==='admin'), canMkt=(APP.role==='marketing'||APP.role==='admin');
  if(OPEN_STATES.includes(r.status) && canPAM)
    return `<button class="btn btn-info" onclick="openRequestInfo(${r.id})">Request Info</button>
      <button class="btn btn-reject" onclick="openReject(${r.id})">Reject</button>
      <button class="btn btn-approve" onclick="openApprove(${r.id},'pam')">Approve</button>`;
  if(r.status==='pam_approved' && canMkt)
    return `<button class="btn btn-reject" onclick="openReject(${r.id})">Reject</button>
      <button class="btn btn-approve" onclick="openApprove(${r.id},'final')">Final Approve · ${money0(r.approvedAmount)}</button>`;
  if(r.status==='payout_pending' && canPAM)
    return `<button class="btn btn-teal" onclick="openProcessPayout(${r.id})">Process payout →</button>`;
  if(r.status==='executed' && canPAM)
    return `<button class="btn btn-ghost" onclick="toast('Reminder sent to partner','✉')">Send reminder</button>`;
  return `<button class="btn btn-ghost" onclick="backFromDetail()">Back to list</button>`;
}

/* ════════ ACTION MODALS ════════════════════════════ */

/* PAM approve (editable amount) OR Marketing final approve */
function openApprove(id, stage){
  const r=REQUESTS.find(x=>x.id===id); const p=partnerOf(r);
  const defAmt = stage==='final' ? (r.approvedAmount||r.requestedCofund) : (r.approvedAmount||r.requestedCofund);
  const over = defAmt > p.budget.available + (r.approvedAmount||0);
  openModal(`
    <div class="modal-hd"><div class="modal-title">${stage==='final'?'Final approval':'Approve request'}</div>
      <div class="modal-desc">${r.ref} · ${r.name}</div></div>
    <div class="modal-bd">
      ${stage==='pam'?`
        <div class="field"><label class="fl">Approved co-fund amount (CAD)</label>
          <input class="fi mono" id="appr-amt" type="number" value="${defAmt}" oninput="apprPreview(${id})"/>
          <div class="hint-txt">Requested: ${money0(r.requestedCofund)} (${r.cofundPct}% of ${money0(r.requested)}). You may approve a different amount.</div>
        </div>`:`
        <div class="msum"><div class="msum-row"><span class="l">PAM-approved amount</span><span class="v">${money0(r.approvedAmount)}</span></div>
          <div class="msum-row"><span class="l">Partner available balance</span><span class="v">${money0(p.budget.available)}</span></div>
          <div class="msum-row total"><span class="l">Commit on approval</span><span class="v">${money0(r.approvedAmount)}</span></div></div>`}
      <div class="field"><label class="fl">${stage==='final'?'Approval note (optional)':'Internal note (optional)'}</label>
        <textarea class="fi fi-ta" id="appr-note" placeholder="${stage==='pam'?'e.g. trimmed ad-spend line to match prior efficiency…':'Visible in audit log…'}" style="min-height:64px"></textarea></div>
      <div id="appr-warn">${over?overWarn(r,defAmt):''}</div>
    </div>
    <div class="modal-ft"><button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-approve" onclick="doApprove(${id},'${stage}')">${stage==='final'?'Approve & notify partner':'Approve & escalate'}</button></div>`);
}
function overWarn(r,amt){ return `<div class="banner banner-amber" style="margin:0"><div class="banner-icon">!</div><div><div class="banner-title">Over available balance</div><div class="banner-body">This commits ${money0(amt)} against ${money0(partnerOf(r).budget.available)} available. The budget will be over-committed.</div></div></div>`; }
function apprPreview(id){ const r=REQUESTS.find(x=>x.id===id); const amt=+$('#appr-amt').value||0; $('#appr-warn').innerHTML = amt>partnerOf(r).budget.available?overWarn(r,amt):''; }

function doApprove(id, stage){
  const r=REQUESTS.find(x=>x.id===id); const p=partnerOf(r); const note=$('#appr-note')?.value.trim();
  if(stage==='pam'){
    const amt=+$('#appr-amt').value||0;
    r.approvedAmount=amt; r.status='pam_approved'; r.actionedAt='2026-06-08';
    p.budget.committed += amt; recomputeAvailable(p.budget);
    // collapse "awaiting marketing" future into done + add new future
    r.timeline = r.timeline.filter(t=>t.cls!=='future');
    r.timeline.push({state:'pam_approved',title:`PAM approved — ${money0(amt)}`,who:`${USERS[APP.role].name} (PAM)`,when:nowStamp(),cls:'done',note:note||undefined});
    r.timeline.push({state:'approved',title:'Awaiting Marketing final approval',who:'Priya Anand (Marketing)',when:null,cls:'future'});
    toast(`Approved ${money0(amt)} · escalated to Marketing`);
  } else {
    r.status='approved'; r.approvedAt='2026-06-08';
    r.timeline = r.timeline.filter(t=>t.cls!=='future');
    r.timeline.push({state:'approved',title:`Final approval — ${money0(r.approvedAmount)}`,who:`${USERS[APP.role].name} (Marketing)`,when:nowStamp(),cls:'done',note:note||'Approved. Partner notified.'});
    r.timeline.push({state:'executed',title:'Awaiting event execution',who:null,when:null,cls:'future'});
    toast('Final approval sent · partner notified');
  }
  closeModal(); refreshAfterAction(id);
}

/* Reject (reason mandatory) */
function openReject(id){
  const r=REQUESTS.find(x=>x.id===id);
  openModal(`
    <div class="modal-hd"><div class="modal-title">Reject request</div><div class="modal-desc">${r.ref} · ${r.name}</div></div>
    <div class="modal-bd">
      <div class="banner banner-red" style="margin:0 0 16px"><div class="banner-icon">!</div><div><div class="banner-title">This is shown to the partner</div><div class="banner-body">Provide a clear reason — it appears prominently on the partner's request.</div></div></div>
      <div class="field"><label class="fl">Rejection reason <span style="color:var(--red)">*</span></label>
        <textarea class="fi fi-ta" id="rej-reason" placeholder="Explain why this request is not eligible and what the partner could do differently…"></textarea>
        <div class="hint-txt" id="rej-err" style="color:var(--red);display:none">A reason is required.</div></div>
    </div>
    <div class="modal-ft"><button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-reject" onclick="doReject(${id})">Reject & notify partner</button></div>`);
}
function doReject(id){
  const r=REQUESTS.find(x=>x.id===id); const reason=$('#rej-reason').value.trim();
  if(!reason){ $('#rej-err').style.display='block'; return; }
  // release any committed funds
  if(r.approvedAmount){ const b=partnerOf(r).budget; b.committed=Math.max(0,b.committed-r.approvedAmount); recomputeAvailable(b); }
  r.status='rejected'; r.rejectionReason=reason; r.actionedAt='2026-06-08';
  r.timeline = r.timeline.filter(t=>t.cls!=='future');
  r.timeline.push({state:'rejected',title:'Request rejected',who:`${USERS[APP.role].name} (${cap(APP.role)})`,when:nowStamp(),cls:'reject',note:reason});
  closeModal(); toast('Request rejected · partner notified','✕'); refreshAfterAction(id);
}

/* Request info (message mandatory) */
function openRequestInfo(id){
  const r=REQUESTS.find(x=>x.id===id);
  openModal(`
    <div class="modal-hd"><div class="modal-title">Request more information</div><div class="modal-desc">${r.ref} · ${r.name}</div></div>
    <div class="modal-bd">
      <div class="field"><label class="fl">Message to partner <span style="color:var(--red)">*</span></label>
        <textarea class="fi fi-ta" id="info-msg" placeholder="What's missing? e.g. attach the media plan, confirm featured Zoho products…"></textarea>
        <div class="hint-txt" id="info-err" style="color:var(--red);display:none">A message is required.</div>
        <div class="hint-txt">Status moves to <strong>Pending Info</strong>. The SLA clock pauses until the partner responds.</div></div>
    </div>
    <div class="modal-ft"><button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-info" onclick="doRequestInfo(${id})">Send & set Pending Info</button></div>`);
}
function doRequestInfo(id){
  const r=REQUESTS.find(x=>x.id===id); const msg=$('#info-msg').value.trim();
  if(!msg){ $('#info-err').style.display='block'; return; }
  r.status='pending_info'; r.infoRequest=msg;
  r.timeline = r.timeline.filter(t=>t.cls!=='future');
  r.timeline.push({state:'pending_info',title:'More information requested',who:`${USERS[APP.role].name} (${cap(APP.role)})`,when:nowStamp(),cls:'current',note:msg});
  closeModal(); toast('Info request sent to partner','✉'); refreshAfterAction(id);
}

/* Process payout (Partner Store sync simulation) */
function openProcessPayout(id){
  const r=REQUESTS.find(x=>x.id===id); const py=r.payout; const p=partnerOf(r);
  const calc=Math.min(Math.round(py.actualSpend*r.cofundPct/100), r.approvedAmount, p.budget.available + (r.approvedAmount||0));
  openModal(`
    <div class="modal-hd"><div class="modal-title">Process payout</div><div class="modal-desc">${r.ref} · ${p.name}</div></div>
    <div class="modal-bd">
      <div class="field"><label class="fl">Payout amount (CAD)</label>
        <input class="fi mono" id="pay-amt" type="number" value="${calc}"/>
        <div class="hint-txt">Auto-calculated as min(actual spend × ${r.cofundPct}%, approved cap, available balance) = <strong>${money0(calc)}</strong>.</div></div>
      <div class="field"><label class="fl">Disbursement method</label>
        <select class="fi fi-sel" id="pay-method">
          <option value="api">Partner Store API (automatic)</option>
          <option value="manual">Manual disbursement (CSV fallback)</option>
        </select>
        <div class="hint-txt">If the Partner Store payout API is unavailable, the manual fallback marks the payout <em>pending manual disbursement</em>.</div></div>
    </div>
    <div class="modal-ft"><button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-teal" id="pay-go" onclick="doProcessPayout(${id})">Disburse payout</button></div>`);
}
function doProcessPayout(id){
  const r=REQUESTS.find(x=>x.id===id); const amt=+$('#pay-amt').value||0; const method=$('#pay-method').value;
  const btn=$('#pay-go'); btn.disabled=true; btn.innerHTML='<span class="sync-spin"></span> Contacting Partner Store…';
  setTimeout(()=>{
    const p=partnerOf(r); const b=p.budget;
    b.committed=Math.max(0,b.committed-(r.approvedAmount||0)); b.paid+=amt; recomputeAvailable(b);
    r.payout.payoutAmount=amt; r.payout.paidAt='2026-06-08';
    r.status='paid';
    if(method==='manual'){ r.payout.syncStatus='manual'; r.payout.storeId='PENDING-MANUAL'; }
    else { r.payout.syncStatus='ok'; r.payout.storeId='PS-PAYOUT-'+(80000+Math.floor(Math.random()*9999)); }
    r.timeline = r.timeline.filter(t=>t.cls!=='future');
    r.timeline.push({state:'paid',title:`Payout ${method==='manual'?'queued (manual)':'disbursed'} — ${money0(amt)}`,who:`${USERS[APP.role].name} (PAM)`,when:nowStamp(),cls:'pay',note:method==='manual'?'Partner Store API skipped. Marked pending manual disbursement — PAM to submit CSV.':`Partner Store payout ${r.payout.storeId} confirmed.`});
    closeModal(); toast(method==='manual'?'Payout queued for manual disbursement':'Payout disbursed & synced','$'); refreshAfterAction(id);
  },1300);
}

/* ── refresh after any mutation ──────────────────── */
function refreshAfterAction(id){
  renderNav();
  if($('#screen-detail').classList.contains('active')) renderDetail(id);
  else { const r={dashboard:renderDashboard,queue:renderQueue,approved:renderApproved,payouts:renderPayouts,partners:renderPartners,reports:renderReports,config:renderConfig,sla:renderSLA,exceptions:renderExceptions,duplicates:renderDuplicates}[APP.screen]; if(r)r(); }
}

/* ═══════════════════════════════════════════════════════════
   SCREENS: Approved · Payouts · Partners · Reports · Config
   ═══════════════════════════════════════════════════════════ */

/* ── simple reusable list table ──────────────────── */
function listTable(cols, rows){
  const gt = cols.map(c=>c.w).join(' ');
  return `<div class="qtable"><div class="qt-head" style="grid-template-columns:${gt}">${cols.map(c=>`<div class="${c.r?'qt-cell-r':''}">${c.label}</div>`).join('')}</div>
    ${rows.map(r=>`<div class="qt-row" style="grid-template-columns:${gt}" onclick="openDetail(${r.id})">${r.cells.map((c,i)=>`<div class="${cols[i].r?'qt-cell-r':''}" style="min-width:0">${c}</div>`).join('')}</div>`).join('')}</div>`;
}

/* ── APPROVED ────────────────────────────────────── */
function renderApproved(){
  const data = approvedItems().sort((a,b)=> new Date(b.approvedAt||b.submittedAt)-new Date(a.approvedAt||a.submittedAt));
  const committed = data.filter(r=>['approved','executed','payout_pending'].includes(r.status)).reduce((a,r)=>a+(r.approvedAmount||0),0);
  const paid = data.filter(r=>r.status==='paid').reduce((a,r)=>a+(r.payout?.payoutAmount||0),0);
  const cols=[
    {label:'Reference',w:'120px'},{label:'Activity',w:'minmax(0,1.6fr)'},{label:'Partner',w:'1fr'},
    {label:'Event date',w:'110px'},{label:'Approved',w:'104px',r:true},{label:'Status',w:'128px',r:true}
  ];
  const rows = data.map(r=>{const p=partnerOf(r);return {id:r.id,cells:[
    `<div class="qt-ref">${r.ref}</div>`,
    `<div class="qt-name">${r.name}</div><div class="qt-actline">${ACTIVITY[r.activity]} · ${activityLine(r)}</div>`,
    `<div class="qt-partner">${p.name}</div><div class="qt-partner-sub"><span class="tier ${p.tier}">${p.tier}</span> ${p.territory}</div>`,
    `<span style="font-size:12.5px">${r.eventDate?fmtDate(r.eventDate):'—'}</span>`,
    `<div class="qt-amt">${money0(r.approvedAmount)}</div>`,
    statusBadge(r.status)
  ]};});
  $('#screen-approved').innerHTML = `<div class="list-col"><div class="list-pad">
    <div class="kpi-row kpi-3">
      <div class="kpi accent-green"><div class="kpi-lbl">Approved Requests</div><div class="kpi-val tabnum">${data.length}</div><div class="kpi-meta">this fiscal year</div></div>
      <div class="kpi accent-amber"><div class="kpi-lbl">Committed (unpaid)</div><div class="kpi-val tabnum">${money0(committed)}</div><div class="kpi-meta">awaiting execution & payout</div></div>
      <div class="kpi accent-teal"><div class="kpi-lbl">Paid Out</div><div class="kpi-val tabnum">${money0(paid)}</div><div class="kpi-meta">disbursed to partners</div></div>
    </div>
    ${data.length?listTable(cols,rows):emptyState('—','No approved requests','Approved requests will appear here.')}
  </div></div>`;
}

/* ── PAYOUTS ─────────────────────────────────────── */
function renderPayouts(){
  const items = payoutItems();
  const awaitingForm = items.filter(r=>r.status==='executed');
  const pending = items.filter(r=>r.status==='payout_pending');
  const paid = items.filter(r=>r.status==='paid');
  const data = items.sort((a,b)=>{const o={payout_pending:0,executed:1,paid:2};return (o[a.status]??3)-(o[b.status]??3);});

  const cols=[
    {label:'Reference',w:'120px'},{label:'Activity / Partner',w:'minmax(0,1.7fr)'},
    {label:'Approved',w:'100px',r:true},{label:'Actual spend',w:'110px',r:true},
    {label:'Payout',w:'104px',r:true},{label:'Stage',w:'150px',r:true}
  ];
  const rows = data.map(r=>{const p=partnerOf(r);const py=r.payout;
    const stageCell = r.status==='paid'
      ? `${statusBadge('paid')} ${syncPill(py.syncStatus)}`
      : r.status==='payout_pending'
        ? `<span class="badge badge-payout">Process payout</span>`
        : `<span class="badge badge-executed">Awaiting form</span>`;
    return {id:r.id,cells:[
      `<div class="qt-ref">${r.ref}</div><div class="qt-ref-date">${r.eventDate?'Event '+fmtDateShort(r.eventDate):''}</div>`,
      `<div class="qt-name">${r.name}</div><div class="qt-actline"><span class="av av-sm" style="background:${partnerColor(r.partner)};width:18px;height:18px;font-size:8px">${initials(p.name)}</span> ${p.name}</div>`,
      `<div class="qt-amt">${money0(r.approvedAmount)}</div>`,
      `<div class="qt-amt">${py?money0(py.actualSpend):'—'}</div>`,
      `<div class="qt-amt" style="color:${r.status==='paid'?'var(--teal)':'var(--hint)'}">${py&&py.payoutAmount?money0(py.payoutAmount):'—'}</div>`,
      `<div style="display:flex;gap:5px;justify-content:flex-end;align-items:center;flex-wrap:wrap">${stageCell}</div>`
    ]};});

  $('#screen-payouts').innerHTML = `<div class="list-col"><div class="list-pad">
    <div class="kpi-row kpi-3">
      <div class="kpi accent-blue"><div class="kpi-lbl">Awaiting Post-Event Form</div><div class="kpi-val tabnum">${awaitingForm.length}</div><div class="kpi-meta">partner to submit actuals</div></div>
      <div class="kpi accent-amber"><div class="kpi-lbl">Ready to Process</div><div class="kpi-val tabnum">${pending.length}</div><div class="kpi-meta">${money0(pending.reduce((a,r)=>a+(r.payout?.actualSpend||0),0))} actual spend</div></div>
      <div class="kpi accent-teal"><div class="kpi-lbl">Paid</div><div class="kpi-val tabnum">${paid.length}</div><div class="kpi-meta">${money0(paid.reduce((a,r)=>a+(r.payout?.payoutAmount||0),0))} disbursed</div></div>
    </div>
    <div class="banner banner-blue" style="margin-bottom:18px"><div class="banner-icon">i</div><div><div class="banner-title">Partner Store payout sync</div><div class="banner-body">Approved payouts disburse via the Partner Store API. If unavailable, use the manual CSV fallback — the payout is marked <em>pending manual disbursement</em> and the program stays fully auditable.</div></div></div>
    ${data.length?listTable(cols,rows):emptyState('—','No payouts yet','Executed events and payouts will appear here.')}
  </div></div>`;
}

/* ── PARTNERS ────────────────────────────────────── */
function renderPartners(){
  const pkeys = (APP.role==='pam')
    ? Object.keys(PARTNERS).filter(k=>USERS[APP.role].territories.includes(PARTNERS[k].territory))
    : Object.keys(PARTNERS);
  const cards = pkeys.map(k=>{
    const p=PARTNERS[k]; const b=p.budget;
    const open = REQUESTS.filter(r=>r.partner===k && OPEN_STATES.includes(r.status)).length;
    const total = REQUESTS.filter(r=>r.partner===k && r.status!=='draft').length;
    const lowBal = b.cap && (b.available/b.cap*100) < CONFIG.low_balance_alert_pct;
    return `<div class="card" style="margin-bottom:0">
      <div class="card-hd" style="background:var(--paper-alt);border-bottom:1px solid var(--line);padding:15px 17px">
        <span class="av" style="background:${partnerColor(k)}">${initials(p.name)}</span>
        <div style="min-width:0"><div style="font-weight:600;font-size:14px">${p.name}</div>
          <div class="muted" style="font-size:11.5px"><span class="tier ${p.tier}">${p.tier}</span> · ${p.territory} · ${p.id}</div></div>
        ${b.available<=0?'<span class="flag flag-budget" style="margin-left:auto">Exhausted</span>':lowBal?'<span class="flag flag-dup" style="margin-left:auto">Low balance</span>':''}
      </div>
      <div class="card-bd">
        ${budgetBlockHTML('FY2026 budget', b).replace('<div class="budget-block">','<div class="budget-block" style="border:none;box-shadow:none;padding:0">').replace('<div class="bb-head"><div class="bb-title">FY2026 budget</div><div class="bb-fy">FY2026</div></div>','')}
        <div style="display:flex;gap:18px;margin-top:14px;padding-top:13px;border-top:1px solid var(--bd)">
          <div><div class="hint" style="font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;font-weight:600">Commissionable</div><div style="font-weight:600;font-size:13.5px;margin-top:2px">${money0(p.commissionable)}</div></div>
          <div><div class="hint" style="font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;font-weight:600">Open requests</div><div style="font-weight:600;font-size:13.5px;margin-top:2px">${open}</div></div>
          <div><div class="hint" style="font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;font-weight:600">Total requests</div><div style="font-weight:600;font-size:13.5px;margin-top:2px">${total}</div></div>
          <div style="margin-left:auto;align-self:center"><div class="hint" style="font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;font-weight:600">PAM</div><div style="font-weight:600;font-size:13.5px;margin-top:2px">${p.pam}</div></div>
        </div>
      </div>
    </div>`;
  }).join('');
  $('#screen-partners').innerHTML = `<div class="list-col"><div class="list-pad">
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(420px,1fr));gap:16px">${cards}</div>
  </div></div>`;
}

/* ── REPORTS / ANALYTICS ─────────────────────────── */
function renderReports(){
  const rs = visibleRequests();
  const active = rs.filter(r=>r.status!=='draft');
  const approved = rs.filter(r=>['approved','executed','payout_pending','paid'].includes(r.status));
  const rejected = rs.filter(r=>r.status==='rejected');
  const apprRate = (approved.length+rejected.length)? Math.round(approved.length/(approved.length+rejected.length)*100):0;
  const totalCommitted = approved.reduce((a,r)=>a+(r.approvedAmount||0),0);
  const totalPaid = rs.filter(r=>r.status==='paid').reduce((a,r)=>a+(r.payout?.payoutAmount||0),0);

  // by tier
  const byTier = {authorized:0,advanced:0,premium:0};
  approved.forEach(r=> byTier[partnerOf(r).tier]+=(r.approvedAmount||0));
  const maxTier = Math.max(1,...Object.values(byTier));
  // by territory
  const byTerr = {};
  approved.forEach(r=>{const t=partnerOf(r).territory; byTerr[t]=(byTerr[t]||0)+(r.approvedAmount||0);});
  const maxTerr = Math.max(1,...Object.values(byTerr),1);
  // by status
  const byStatus = {};
  active.forEach(r=> byStatus[r.status]=(byStatus[r.status]||0)+1);
  const maxStatus = Math.max(1,...Object.values(byStatus));

  // PAM workload
  const pams = {};
  rs.forEach(r=>{ const pam=partnerOf(r).pam; if(!pams[pam])pams[pam]={open:0,breach:0,total:0}; if(r.status!=='draft')pams[pam].total++; if(OPEN_STATES.includes(r.status)){pams[pam].open++; const s=slaInfo(r); if(s&&s.sev===3)pams[pam].breach++;} });

  const tierColor={authorized:'#71717A',advanced:'#1A4F8A',premium:'#5B21B6'};
  $('#screen-reports').innerHTML = `<div class="list-col"><div class="list-pad">
    <div class="kpi-row kpi-4">
      <div class="kpi accent-blue"><div class="kpi-lbl">Active Requests</div><div class="kpi-val tabnum">${active.length}</div><div class="kpi-meta">FY2026</div></div>
      <div class="kpi accent-green"><div class="kpi-lbl">Approval Rate</div><div class="kpi-val tabnum">${apprRate}%</div><div class="kpi-meta">${approved.length} approved · ${rejected.length} rejected</div></div>
      <div class="kpi accent-amber"><div class="kpi-lbl">Total Committed</div><div class="kpi-val tabnum">${money0(totalCommitted)}</div><div class="kpi-meta">across program</div></div>
      <div class="kpi accent-teal"><div class="kpi-lbl">Total Paid</div><div class="kpi-val tabnum">${money0(totalPaid)}</div><div class="kpi-meta">disbursed</div></div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start">
      <div class="card"><div class="card-hd"><div class="ch-title">Committed funds by tier</div></div><div class="card-bd"><div class="bars">
        ${Object.entries(byTier).map(([t,v])=>`<div class="bar-row"><div><span class="tier ${t}">${t}</span></div><div class="bar-track"><div class="bar-fill" style="width:${Math.max(6,v/maxTier*100)}%;background:${tierColor[t]}"></div></div><div class="bar-val">${money0(v)}</div></div>`).join('')}
      </div></div></div>
      <div class="card"><div class="card-hd"><div class="ch-title">Committed funds by territory</div></div><div class="card-bd"><div class="bars">
        ${Object.entries(byTerr).sort((a,b)=>b[1]-a[1]).map(([t,v])=>`<div class="bar-row" style="grid-template-columns:140px 1fr 64px"><div style="font-size:12px">${t}</div><div class="bar-track"><div class="bar-fill" style="width:${Math.max(6,v/maxTerr*100)}%;background:var(--teal)"></div></div><div class="bar-val">${money0(v)}</div></div>`).join('')}
      </div></div></div>
      <div class="card"><div class="card-hd"><div class="ch-title">Requests by status</div></div><div class="card-bd"><div class="bars">
        ${Object.entries(byStatus).sort((a,b)=>b[1]-a[1]).map(([s,v])=>`<div class="bar-row" style="grid-template-columns:140px 1fr 44px"><div>${statusBadge(s)}</div><div class="bar-track"><div class="bar-fill" style="width:${Math.max(6,v/maxStatus*100)}%;background:var(--blue)"></div></div><div class="bar-val">${v}</div></div>`).join('')}
      </div></div></div>
      <div class="card"><div class="card-hd"><div class="ch-title">PAM workload</div></div><div class="card-bd pad0" style="padding:0">
        <div class="qt-head" style="grid-template-columns:1fr 80px 80px 90px"><div>PAM</div><div class="qt-cell-r">Total</div><div class="qt-cell-r">Open</div><div class="qt-cell-r">Breached</div></div>
        ${Object.entries(pams).map(([pam,w])=>`<div class="qt-row" style="grid-template-columns:1fr 80px 80px 90px;cursor:default"><div class="qt-partner">${pam}</div><div class="qt-cell-r mono">${w.total}</div><div class="qt-cell-r mono">${w.open}</div><div class="qt-cell-r mono" style="color:${w.breach?'var(--red)':'var(--text)'};font-weight:${w.breach?700:400}">${w.breach}</div></div>`).join('')}
      </div></div>
    </div>
  </div></div>`;

  // Append ROI section
  const roi_html = `
    <div style="margin-top:24px">
      <div class="sec-label">Program Effectiveness & ROI</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
        <div class="card"><div class="card-hd"><div class="ch-title">Average cycle time</div><div class="ch-side">Submission → Paid</div></div><div class="card-bd">
          <div class="bars">
            ${[
              ['Submission → PAM action', Math.round(Math.random()*2+1.5), 'var(--blue)'],
              ['PAM action → Final approval', Math.round(Math.random()*1.5+0.5), 'var(--purple)'],
              ['Approval → Execution', Math.round(Math.random()*20+12), 'var(--amber)'],
              ['Execution → Payout', Math.round(Math.random()*5+3), 'var(--teal)'],
            ].map(([l,v,c])=>`<div class="bar-row" style="grid-template-columns:190px 1fr 50px"><div style="font-size:12px">${l}</div><div class="bar-track"><div class="bar-fill" style="width:${Math.min(100,v/30*100)}%;background:${c}">${v}d</div></div><div class="bar-val">${v}d</div></div>`).join('')}
          </div>
        </div></div>
        <div class="card"><div class="card-hd"><div class="ch-title">Which activity types perform</div><div class="ch-side">Approval rate by type</div></div><div class="card-bd">
          <div class="bars">
            ${[['Events (self-hosted)',88,'var(--teal)'],['Events (third-party)',72,'var(--blue)'],['Webinar',91,'var(--green)'],['Custom GTM',67,'var(--amber)']].map(([l,v,c])=>`
            <div class="bar-row"><div style="font-size:12px">${l}</div><div class="bar-track"><div class="bar-fill" style="width:${v}%;background:${c}">${v}%</div></div><div class="bar-val">${v}%</div></div>`).join('')}
          </div>
        </div></div>
        <div class="card" style="grid-column:1/-1"><div class="card-hd"><div class="ch-title">Top rejection reasons</div><div class="ch-side">Why requests don't get approved</div></div><div class="card-bd">
          <div class="bars">
            ${[
              ['Attendee-only / no lead capture mechanism', 3, 'var(--red)'],
              ['Missing documentation / media plan', 2, 'var(--amber)'],
              ['Duplicate activity within detection window', 1, 'var(--amber)'],
              ['Budget exhausted — no available balance', 1, 'var(--red)'],
            ].map(([l,v,c])=>`<div class="bar-row" style="grid-template-columns:minmax(0,2fr) 1fr 24px"><div style="font-size:12px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${l}</div><div class="bar-track"><div class="bar-fill" style="width:${v/4*100}%;background:${c}"></div></div><div class="bar-val">${v}</div></div>`).join('')}
          </div>
        </div></div>
      </div>
    </div>`;
  $('#screen-reports').innerHTML = $('#screen-reports').innerHTML.replace('</div></div>','') + roi_html + '</div></div>';
}

/* ── ADMIN CONFIGURATION ─────────────────────────── */
function renderConfig(){
  if(APP.role!=='admin'){ $('#screen-config').innerHTML=`<div class="list-col"><div class="list-pad">${emptyState('🔒','Admin access required','Switch to the MDF Administrator role to manage configuration.')}</div></div>`; return; }
  const groups = {};
  Object.entries(CONFIG_META).forEach(([k,m])=>{ (groups[m.group]=groups[m.group]||[]).push(k); });
  const groupCards = Object.entries(groups).map(([g,keys])=>`
    <div class="card"><div class="card-hd"><div class="ch-title">${g}</div></div><div class="card-bd pad0" style="padding:0">
      ${keys.map(k=>{const m=CONFIG_META[k];return `<div class="cfg-row">
        <div><div class="cfg-name">${m.label}</div><div class="cfg-desc">${m.desc}</div><div class="cfg-key">${k}</div></div>
        <div class="row" style="gap:8px">
          ${m.text
            ? `<input class="fi" id="cfg-${k}" value="${CONFIG[k]}" oninput="markDirty()"/>`
            : `<input class="fi mono" id="cfg-${k}" type="number" value="${CONFIG[k]}" oninput="markDirty()" style="text-align:right"/>${m.unit?`<span class="muted" style="font-size:12px;min-width:34px">${m.unit}</span>`:''}`}
        </div>
      </div>`;}).join('')}
    </div></div>`).join('');

  $('#screen-config').innerHTML = `<div class="list-col"><div class="list-pad">
    <div class="banner banner-blue" style="margin-bottom:18px"><div class="banner-icon">i</div><div><div class="banner-title">Live policy values</div><div class="banner-body">These drive validation and budget math across both portals — no code deploy required. Every change writes an audit-log entry. Budget-cap percentages recalculate partner caps on the next sync.</div></div></div>
    ${groupCards}
    <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:18px">
      <button class="btn btn-ghost" id="cfg-reset" onclick="renderConfig()">Discard changes</button>
      <button class="btn btn-primary" id="cfg-save" onclick="saveConfig()" disabled>Save configuration</button>
    </div>
  </div></div>`;
}
let cfgDirty=false;
function markDirty(){ cfgDirty=true; const b=$('#cfg-save'); if(b)b.disabled=false; }
function saveConfig(){
  Object.keys(CONFIG_META).forEach(k=>{ const el=$('#cfg-'+k); if(!el)return; CONFIG[k]= CONFIG_META[k].text? el.value : (+el.value||0); });
  cfgDirty=false; $('#cfg-save').disabled=true;
  toast('Configuration saved · audit log updated','✓');
}

</script>
<script>
window.MDF_PAGE = {
  id: "pam",
  breadcrumbs: [{label:"PAM Portal", href:"./index.html"}]
};
</script>
<script>

/* ── MDF SHARED SHELL JS ───────────────────────────────────── */
(function(){
  const P = window.MDF_PAGE || {};
  const pages = [
    {id:'home',   label:'Home',            href:'../index.html',       badge:null},
    {id:'partner',label:'Partner Portal',  href:'../partner/index.html', badge:'partner'},
    {id:'pam',    label:'PAM Portal',      href:'../pam/index.html',   badge:'pam'},
    {id:'guide',  label:'Feature Guide',   href:'../guide/index.html', badge:'guide'},
  ];
  const isRoot = P.isRoot;
  // Adjust hrefs for root-level index
  if(isRoot) pages.forEach(p=>{
    p.href = p.href.replace('../','./');
  });

  // ── TOPBAR
  const tb = document.createElement('div');
  tb.className = 'sh-topbar';
  tb.innerHTML = `
    <a class="sh-brand" href="${isRoot?'./index.html':'../index.html'}">
      <div class="sh-mark">Z</div>
      <div>
        <div class="sh-brand-name">Zoho Partner Growth</div>
        <div class="sh-brand-sub">MDF Portal</div>
      </div>
    </a>
    <nav class="sh-nav">
      ${pages.filter(p=>p.id!=='home').map(p=>`
        <a class="sh-nav-link ${P.id===p.id?'active':''}" href="${p.href}">${p.label}</a>
        ${p.badge?`<span class="sh-portal-badge ${p.badge}" style="display:none">${p.badge}</span>`:''}
      `).join('<span class="sh-nav-sep">·</span>')}
    </nav>`;
  document.body.insertBefore(tb, document.body.firstChild);

  // ── BREADCRUMB
  if(P.breadcrumbs && P.breadcrumbs.length){
    const bc = document.createElement('div');
    bc.className = 'sh-breadcrumb';
    bc.innerHTML = [
      `<a class="sh-bc-item" href="${isRoot?'./index.html':'../index.html'}">MDF</a>`,
      ...P.breadcrumbs.map((b,i)=>
        i===P.breadcrumbs.length-1
          ? `<span class="sh-bc-sep">›</span><span class="sh-bc-current">${b.label}</span>`
          : `<span class="sh-bc-sep">›</span><a class="sh-bc-item" href="${b.href}">${b.label}</a>`
      )
    ].join('');
    document.body.insertBefore(bc, tb.nextSibling);
  }

  // ── FOOTER
  const ft = document.createElement('div');
  ft.className = 'sh-footer';
  ft.innerHTML = `
    <div class="sh-footer-brand">
      <div style="width:26px;height:26px;background:var(--sh-clay);border-radius:7px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;color:#fff">Z</div>
      <span style="color:#C4B39E;font-weight:600">Zoho Partner Growth — MDF</span>
    </div>
    <div class="sh-footer-links">
      ${pages.map(p=>`<a class="sh-footer-link" href="${p.href}">${p.label}</a>`).join('')}
    </div>
    <div class="sh-footer-right">Zoho Canada · Partner Programs · v1.0 · June 2026</div>`;
  document.body.appendChild(ft);
})();

</script>
</body>
</html>